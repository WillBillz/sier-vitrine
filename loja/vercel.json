{
  "functions": {
    "api/*.js": {
      "includeFiles": "catalogo.json",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/elton",
      "destination": "/elton.html"
    },
    {
      "source": "/elton/",
      "destination": "/elton.html"
    }
  ]
}
